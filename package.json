{
  "name": "marketplace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @marketplace/db prisma generate",
    "db:push": "pnpm --filter @marketplace/db prisma db push",
    "db:studio": "pnpm --filter @marketplace/db prisma studio",
    "test:provision": "tsx scripts/test-provision.ts",
    "seed": "tsx scripts/seed.ts",
    "validate-agent": "node scripts/validate-agent.mjs",
    "vet-agent": "node scripts/vet-agent.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bullmq": "^5.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@clerk/shared",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
