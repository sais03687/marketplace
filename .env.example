# ── Database ──────────────────────────────────────────────────────────────────
# Local:      postgresql://marketplace:marketplace@localhost:5432/marketplace
# Production: get from Neon / Supabase dashboard
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local:      redis://localhost:6379
# Production: get from Upstash dashboard (use the rediss:// TLS URL)
REDIS_URL=redis://localhost:6379

# ── Agent runner ──────────────────────────────────────────────────────────────
# Every agent runs in its own Docker container built from the creator's package.
OPENCLAW_HOOKS_TOKEN=

# ── AgentMail ─────────────────────────────────────────────────────────────────

# ── Microsoft 365 (platform tenant) ───────────────────────────────────────────
# The workspace provider for every deployment. Azure app registration with
# application (not delegated) Graph permissions; the client secret expires, so
# note the expiry when you create it.
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=...

# ── Provisioning service ──────────────────────────────────────────────────────
# Bearer token the web app presents to the provisioning service. Generate with:
# openssl rand -hex 32
PROVISIONING_SECRET=change-me-in-prod
PROVISIONING_PORT=3003
# Public hostname of the Teams bot endpoint.
BOT_HOSTNAME=bot.your-domain.com
# Public URL of the web app. The pollers call this for the sender allowlist and
# pending approvals — if it is unset they fall back to http://localhost:3002 and
# the allowlist silently fails open (every sender allowed), so set it explicitly.
MARKETPLACE_URL=https://www.your-domain.com

# Where the deploymentId → Microsoft tenant cache is persisted. This must point
# OUTSIDE the repo: if unset it defaults to .tenant-cache.json in the service's
# working directory, which drops a state file inside the git tree.
# Production uses /var/lib/marketplace/tenant-cache.json.
TENANT_CACHE_PATH=/var/lib/marketplace/tenant-cache.json

# ── Approval webhook ─────────────────────────────────────────────────────────
# Must be the public URL of the web app so the provisioning service can call back
MARKETPLACE_APPROVAL_WEBHOOK=https://your-app.vercel.app
APPROVAL_WEBHOOK_TOKEN=change-me

# ── Web app public URL ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Vercel Blob (package storage) ─────────────────────────────────────────────
# Enable Blob in your Vercel project → Storage → Create Store
# Then copy the values from the auto-generated .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Public base URL of your blob store (shown in Vercel dashboard)
BLOB_BASE_URL=https://abc.public.blob.vercel-storage.com

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Add webhook endpoint in Stripe dashboard → Developers → Webhooks
# URL: https://your-app.vercel.app/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
PLATFORM_REVENUE_SHARE=0.30

# ── Cron auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-in-prod

# ── Clerk auth ────────────────────────────────────────────────────────────────
# Get from Clerk dashboard → API Keys (use production instance keys for prod)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── LLM (agent runtime) ───────────────────────────────────────────────────────
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=google/gemini-2.5-flash
LLM_BASE_URL=https://openrouter.ai/api/v1

# ── AgentMind reflection LLM (Gemini) ────────────────────────────────────────
AGENTMIND_REFLECTION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AGENTMIND_REFLECTION_API_KEY=AIza...
AGENTMIND_REFLECTION_MODEL=gemini-2.0-flash

# ── Google Workspace — DEPRECATED, leave unset ────────────────────────────────
# Every deployment now provisions on Microsoft 365 (workspaceProvider=MICROSOFT).
# Leave these blank: setting GOOGLE_SERVICE_ACCOUNT_KEY re-enables the pollers'
# drive-watcher, which then polls the Google Drive API every 30s per poller for
# a provider nothing uses. It is disabled in production for exactly that reason.
# GCP_PROJECT_ID=your-gcp-project
# GCP_IAM_KEY=base64-encoded-service-account-json
# GOOGLE_SERVICE_ACCOUNT_EMAIL=alex-agent@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY=base64-encoded-service-account-json
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REFRESH_TOKEN=...

# ── Gemini (direct, used by provisioning service) ─────────────────────────────
GEMINI_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-v1-...
