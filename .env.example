DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379
RUNNER_MODE=local
OPENCLAW_IMAGE=marketplace/agent-runner:latest
AGENTMAIL_API_KEY=am_...
ANTHROPIC_API_KEY=sk-ant-...
