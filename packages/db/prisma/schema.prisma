generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Creator {
  id              String   @id @default(cuid())
  clerkUserId     String   @unique
  displayName     String
  email           String   @unique
  stripeAccountId String?
  stripeOnboarded Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  agents          Agent[]
  payouts         Payout[]
  apiKeys         CreatorApiKey[]
}

model CreatorApiKey {
  id          String    @id @default(cuid())
  creatorId   String
  creator     Creator   @relation(fields: [creatorId], references: [id])
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Agent {
  id                  String                  @id @default(cuid())
  slug                String                  @unique
  name                String
  tagline             String
  description         String
  category            AgentCategory
  pricePerMonth       Int
  modelTier           ModelTier
  creatorId           String
  status              AgentStatus             @default(DRAFT)
  runtime             AgentRuntime            @default(CUSTOM)
  currentVersion      String?
  packageUrl          String?
  averageRating       Float?
  totalDeployments    Int                     @default(0)
  avgApprovalRate     Float?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  memoryTemplate      String?
  onboardingQuestions Json?
  creator             Creator                 @relation(fields: [creatorId], references: [id])
  versions            AgentVersion[]
  capabilities        Capability[]
  deployments         Deployment[]
  contributions       KnowledgeContribution[]
  reviews             Review[]
}

model AgentVersion {
  id           String    @id @default(cuid())
  agentId      String
  version      String
  packageUrl   String
  changelog    String?
  testResults  Json?
  vetStatus    VetStatus @default(PENDING)
  vetNotes     String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  manifestData Json?
  storagePath  String?
  agent        Agent     @relation(fields: [agentId], references: [id])
}

model Capability {
  id          String @id @default(cuid())
  agentId     String
  name        String
  description String
  agent       Agent  @relation(fields: [agentId], references: [id])
}

model Company {
  id               String                  @id @default(cuid())
  clerkOrgId       String                  @unique
  name             String
  domain           String
  timezone         String                  @default("America/New_York")
  stripeCustomerId String?
  plan             CompanyPlan             @default(PAY_PER_AGENT)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deployments      Deployment[]
}

model Deployment {
  id                            String                  @id @default(cuid())
  companyId                     String
  agentId                       String
  agentVersion                  String
  status                        DeploymentStatus        @default(PROVISIONING)
  agentName                     String
  agentEmail                    String?
  agentEmailApiKey              String?
  slackBotToken                 String?
  slackAppToken                 String?
  slackAppId                    String?
  containerName                 String?
  stripeSubscriptionId          String?
  autonomyConfig                Json
  onboardingState               OnboardingState         @default(INTERVIEW)
  onboardingData                Json?
  approvalWebhookToken          String                  @default(cuid())
  managerEmail                  String?                         @map("weeklyDigestEmail")
  allowedEmails                 Json                    @default("[]")
  autoUpdate                    Boolean                 @default(true)
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  pausedAt                      DateTime?
  pauseReason                   String?
  firedAt                       DateTime?
  agentEmailInboxId             String?
  deploymentServiceAccountEmail String?
  deploymentServiceAccountKey   String?
  deploymentServiceAccountSetup Boolean                 @default(false)
  portalToken                   String?                 @unique @default(cuid())
  workspaceProvider             WorkspaceProvider       @default(NONE)
  workspaceEmail                String?
  workspaceUserId               String?
  msGraphSubId                  String?
  workspaceScope                String                  @default("platform")
  buyerMicrosoftTenantId        String?
  teamsServiceUrl               String?
  mailboxLocation               String                  @default("platform")
  buyerMailboxAddress            String?
  approvals                     Approval[]
  agent                         Agent                   @relation(fields: [agentId], references: [id])
  company                       Company                 @relation(fields: [companyId], references: [id])
  contributions                 KnowledgeContribution[]
  knowledgeVotes                KnowledgeVote[]
  contributionComments          ContributionComment[]
  reviews                       Review[]
  trustScores                   TrustScore[]

  @@index([status])
  @@index([companyId])
}

model Approval {
  id                 String         @id @default(cuid())
  deploymentId       String
  taskType           String
  channel            String
  draft              String
  reasoning          String
  originalRequest    String
  stakesScore        Float
  ambiguityScore     Float
  reversibilityScore Float
  combinedScore      Float
  status             ApprovalStatus @default(PENDING)
  resolvedBy         String?
  resolutionAction   String?
  editDiff           String?
  rejectionReason    String?
  threadId           String?
  createdAt          DateTime       @default(now())
  resolvedAt         DateTime?
  expiresAt          DateTime
  deployment         Deployment     @relation(fields: [deploymentId], references: [id])

  @@index([status])
  @@index([deploymentId])
}

model TrustScore {
  id             String     @id @default(cuid())
  deploymentId   String
  taskType       String
  approvedNoEdit Int        @default(0)
  edited         Int        @default(0)
  rejected       Int        @default(0)
  weightedScore  Float      @default(0)
  autonomyLevel  String     @default("always_queue")
  lastUpdated    DateTime   @default(now())
  deployment     Deployment @relation(fields: [deploymentId], references: [id])

  @@unique([deploymentId, taskType])
}

model Review {
  id           String     @id @default(cuid())
  deploymentId String
  agentId      String
  rating       Int
  headline     String
  body         String
  verifiedHire Boolean    @default(true)
  createdAt    DateTime   @default(now())
  agent        Agent      @relation(fields: [agentId], references: [id])
  deployment   Deployment @relation(fields: [deploymentId], references: [id])
}

model ProvisioningLog {
  id           String   @id @default(cuid())
  deploymentId String
  step         String
  attempt      Int      @default(1)
  status       String
  message      String?
  errorStack   String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([deploymentId])
}

model KnowledgeContribution {
  id              String             @id @default(cuid())
  agentId         String
  deploymentId    String
  type            ContributionType
  title           String
  content         String
  rawContent      String
  context         String?
  tags            String[]
  status          ContributionStatus @default(PENDING)
  reviewNote      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  usageCount      Int                @default(0)
  upvotes         Int                @default(0)
  downvotes       Int                @default(0)
  commentCount    Int                @default(0)
  sanitizationLog Json?
  // Semantic search vector for this contribution (title + content), produced by
  // all-MiniLM-L6-v2 running on the provisioning host. Float[] rather than
  // pgvector: the extension is available on this database but a vector column
  // needs Unsupported(...) in Prisma and hand-written SQL everywhere the model is
  // touched, and at this corpus size a scan with cosine in JS costs nothing.
  // Switch to pgvector with an HNSW index if this ever grows past a few thousand.
  embedding       Float[]
  embeddedAt      DateTime?
  createdAt       DateTime           @default(now())
  agent           Agent              @relation(fields: [agentId], references: [id])
  deployment      Deployment         @relation(fields: [deploymentId], references: [id])
  votes           KnowledgeVote[]
  comments        ContributionComment[]

  @@index([agentId, status])
  @@index([status])
}

model ContributionComment {
  id             String                @id @default(cuid())
  contributionId String
  deploymentId   String
  agentName      String
  content        String
  createdAt      DateTime              @default(now())
  contribution   KnowledgeContribution @relation(fields: [contributionId], references: [id])
  deployment     Deployment            @relation(fields: [deploymentId], references: [id])

  @@index([contributionId])
}

model Payout {
  id                String       @id @default(cuid())
  creatorId         String
  periodStart       DateTime
  periodEnd         DateTime
  grossRevenueCents Int
  platformFeeCents  Int
  creatorShareCents Int
  status            PayoutStatus @default(PENDING)
  stripeTransferId  String?
  failureReason     String?
  createdAt         DateTime     @default(now())
  paidAt            DateTime?
  creator           Creator      @relation(fields: [creatorId], references: [id])

  @@index([creatorId, periodStart])
  @@index([status])
}

model KnowledgeVote {
  id             String                @id @default(cuid())
  contributionId String
  deploymentId   String
  vote           Int
  createdAt      DateTime              @default(now())
  contribution   KnowledgeContribution @relation(fields: [contributionId], references: [id])
  deployment     Deployment            @relation(fields: [deploymentId], references: [id])

  @@unique([contributionId, deploymentId])
}

enum AgentCategory {
  SALES_OPERATIONS
  CUSTOMER_SUCCESS
  EXECUTIVE_ASSISTANT
  RESEARCH
  MARKETING_OPS
  HR_OPS
  FINANCE_OPS
  ENGINEERING_OPS
  GENERAL
  IT_SUPPORT
}

enum AgentRuntime {
  CUSTOM
}

enum AgentStatus {
  DRAFT
  IN_REVIEW
  LIVE
  SUSPENDED
}

enum VetStatus {
  PENDING
  PASSED
  FAILED
  MANUALLY_APPROVED
}

enum DeploymentStatus {
  PENDING_PAYMENT
  PROVISIONING
  ONBOARDING
  ACTIVE
  PAUSED
  FIRED
  ERROR
}

enum OnboardingState {
  INTERVIEW
  OBSERVATION
  INTRODUCTION
  LIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EDITED
  REJECTED
  EXPIRED
}

enum ModelTier {
  HAIKU
  SONNET
  OPUS
}

enum CompanyPlan {
  PAY_PER_AGENT
  TEAM
  ENTERPRISE
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContributionType {
  CORRECTION
  PATTERN
  RESPONSE_TEMPLATE
  TASK_RECIPE
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum WorkspaceProvider {
  GOOGLE
  MICROSOFT
  NONE
}
