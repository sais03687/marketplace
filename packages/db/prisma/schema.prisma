generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Creator {
  id              String   @id @default(cuid())
  clerkUserId     String   @unique
  displayName     String
  email           String   @unique
  stripeAccountId String?
  stripeOnboarded Boolean  @default(false)
  // Publishing is gated: a person requests creator access, an admin approves or
  // denies. Uploading a package requires status APPROVED. Existing creators are
  // migrated to APPROVED so nothing they already run breaks; new requests start
  // PENDING. This is the invite-gate for the beta — see /api/creator/request.
  status          CreatorStatus @default(PENDING)
  requestNote     String?       // what the requester said about themselves
  reviewedAt      DateTime?     // when an admin approved or denied
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  agents          Agent[]
  payouts         Payout[]
  apiKeys         CreatorApiKey[]
}

model CreatorApiKey {
  id          String    @id @default(cuid())
  creatorId   String
  creator     Creator   @relation(fields: [creatorId], references: [id])
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Agent {
  id                  String                  @id @default(cuid())
  slug                String                  @unique
  name                String
  tagline             String
  description         String
  category            AgentCategory
  pricePerMonth       Int
  // The model this agent runs on, by id from MODEL_CATALOGUE. Null means the
  // agent predates the catalogue and runs the platform default; modelTier is
  // then whatever it declared. When set, modelTier is derived from it at upload,
  // so the price floor always matches the model the buyer actually gets.
  model               String?
  modelTier           ModelTier
  creatorId           String
  status              AgentStatus             @default(DRAFT)
  runtime             AgentRuntime            @default(CUSTOM)
  currentVersion      String?
  packageUrl          String?
  averageRating       Float?
  avgApprovalRate     Float?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  memoryTemplate      String?
  onboardingQuestions Json?
  creator             Creator                 @relation(fields: [creatorId], references: [id])
  versions            AgentVersion[]
  capabilities        Capability[]
  deployments         Deployment[]
  contributions       KnowledgeContribution[]
  reviews             Review[]
}

model AgentVersion {
  id           String    @id @default(cuid())
  agentId      String
  version      String
  packageUrl   String
  changelog    String?
  testResults  Json?
  vetStatus    VetStatus @default(PENDING)
  vetNotes     String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  manifestData Json?
  storagePath  String?
  agent        Agent     @relation(fields: [agentId], references: [id])
}

model Capability {
  id          String @id @default(cuid())
  agentId     String
  name        String
  description String
  agent       Agent  @relation(fields: [agentId], references: [id])
}

model Company {
  id               String                  @id @default(cuid())
  clerkOrgId       String                  @unique
  name             String
  /// Display only. Never use this to decide who an agent may email — it is
  /// unverified free text and defaulted to the literal "company.com", a real
  /// domain owned by someone else. verifiedDomains is the boundary.
  domain           String
  /// Domains Microsoft says this buyer's tenant actually owns, from
  /// /organization -> verifiedDomains. Empty means "we do not know yet", which
  /// grants nothing — the agent's own mail domain still covers its colleagues.
  verifiedDomains  Json                    @default("[]")
  timezone         String                  @default("America/New_York")
  stripeCustomerId String?
  plan             CompanyPlan             @default(PAY_PER_AGENT)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deployments      Deployment[]
}

model Deployment {
  id                            String                  @id @default(cuid())
  companyId                     String
  agentId                       String
  agentVersion                  String
  status                        DeploymentStatus        @default(PROVISIONING)
  agentName                     String
  agentEmail                    String?
  agentEmailApiKey              String?
  slackBotToken                 String?
  slackAppToken                 String?
  slackAppId                    String?
  containerName                 String?
  stripeSubscriptionId          String?
  autonomyConfig                Json
  onboardingState               OnboardingState         @default(INTERVIEW)
  onboardingData                Json?
  // A read-only snapshot of the agent's MEMORY.md + memory/*.md, pushed up by
  // the agent on a timer so the dashboard can show it. PRIVATE.md is never
  // included - the agent excludes it at source, the same way /internal/memory
  // does. Vercel cannot reach a container, so this mirrors how approvals arrive:
  // the agent writes to the platform, the dashboard reads the platform.
  memorySnapshot                Json?
  memorySyncedAt                DateTime?
  // Liveness. The agent posts a heartbeat on a short timer; the dashboard
  // shows Online when it is recent and Not responding when it is stale, and a
  // periodic check alerts the manager if it goes quiet. This is how a silent
  // failure - a dead container, a stalled poller - becomes visible.
  lastHeartbeatAt               DateTime?
  lastHeartbeatOk               Boolean?
  heartbeatAlertedAt            DateTime?
  approvalWebhookToken          String                  @default(cuid())
  managerEmail                  String?                         @map("weeklyDigestEmail")
  allowedEmails                 Json                    @default("[]")
  autoUpdate                    Boolean                 @default(true)
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  pausedAt                      DateTime?
  pauseReason                   String?
  pauseCreditedThrough          DateTime?
  firedAt                       DateTime?
  agentEmailInboxId             String?
  deploymentServiceAccountEmail String?
  deploymentServiceAccountKey   String?
  deploymentServiceAccountSetup Boolean                 @default(false)
  portalToken                   String?                 @unique @default(cuid())
  workspaceProvider             WorkspaceProvider       @default(NONE)
  workspaceEmail                String?
  workspaceUserId               String?
  msGraphSubId                  String?
  workspaceScope                String                  @default("platform")
  buyerMicrosoftTenantId        String?
  teamsServiceUrl               String?
  mailboxLocation               String                  @default("platform")
  buyerMailboxAddress            String?
  approvals                     Approval[]
  agent                         Agent                   @relation(fields: [agentId], references: [id])
  company                       Company                 @relation(fields: [companyId], references: [id])
  contributions                 KnowledgeContribution[]
  knowledgeVotes                KnowledgeVote[]
  contributionComments          ContributionComment[]
  contributionMutes             ContributionMute[]
  pausePeriods                  PausePeriod[]
  reviews                       Review[]
  trustScores                   TrustScore[]

  @@index([status])
  @@index([companyId])
}

/// One stretch of time a deployment spent paused.
///
/// `pausedAt` on Deployment records only that an agent is paused right now — it
/// is nulled on resume, so the history is destroyed. Both the buyer discount and
/// the creator payout therefore sampled a single instant and applied it to a
/// whole month: a one-day pause could halve a creator's month, and a 25-day
/// pause could earn the buyer nothing. Charging for paused time requires knowing
/// when it was paused, not merely whether it is.
model PausePeriod {
  id           String     @id @default(cuid())
  deploymentId String
  startedAt    DateTime   @default(now())
  /// Null while the agent is still paused. Readers treat null as "open, ongoing"
  /// and clamp it to the end of the window they are measuring.
  endedAt      DateTime?
  reason       String?
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, startedAt])
  @@index([deploymentId, endedAt])
}

model Approval {
  id                 String         @id @default(cuid())
  deploymentId       String
  taskType           String
  channel            String
  draft              String
  reasoning          String
  originalRequest    String
  stakesScore        Float
  ambiguityScore     Float
  reversibilityScore Float
  combinedScore      Float
  status             ApprovalStatus @default(PENDING)
  resolvedBy         String?
  resolutionAction   String?
  editDiff           String?
  rejectionReason    String?
  threadId           String?
  createdAt          DateTime       @default(now())
  resolvedAt         DateTime?
  expiresAt          DateTime
  deployment         Deployment     @relation(fields: [deploymentId], references: [id])

  @@index([status])
  @@index([deploymentId])
}

model TrustScore {
  id             String     @id @default(cuid())
  deploymentId   String
  taskType       String
  approvedNoEdit Int        @default(0)
  edited         Int        @default(0)
  rejected       Int        @default(0)
  weightedScore  Float      @default(0)
  autonomyLevel  String     @default("always_queue")
  lastUpdated    DateTime   @default(now())
  deployment     Deployment @relation(fields: [deploymentId], references: [id])

  @@unique([deploymentId, taskType])
}

model Review {
  id           String     @id @default(cuid())
  deploymentId String
  agentId      String
  rating       Int
  headline     String
  body         String
  verifiedHire Boolean    @default(true)
  createdAt    DateTime   @default(now())
  agent        Agent      @relation(fields: [agentId], references: [id])
  deployment   Deployment @relation(fields: [deploymentId], references: [id])
}

model ProvisioningLog {
  id           String   @id @default(cuid())
  deploymentId String
  step         String
  attempt      Int      @default(1)
  status       String
  message      String?
  errorStack   String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([deploymentId])
}

model KnowledgeContribution {
  id              String             @id @default(cuid())
  agentId         String
  deploymentId    String
  type            ContributionType
  title           String
  content         String
  rawContent      String
  context         String?
  tags            String[]
  status          ContributionStatus @default(PENDING)
  reviewNote      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  usageCount      Int                @default(0)
  upvotes         Int                @default(0)
  downvotes       Int                @default(0)
  commentCount    Int                @default(0)
  sanitizationLog Json?
  // Semantic search vector for this contribution (title + content), produced by
  // all-MiniLM-L6-v2 running on the provisioning host. Float[] rather than
  // pgvector: the extension is available on this database but a vector column
  // needs Unsupported(...) in Prisma and hand-written SQL everywhere the model is
  // touched, and at this corpus size a scan with cosine in JS costs nothing.
  // Switch to pgvector with an HNSW index if this ever grows past a few thousand.
  embedding       Float[]
  embeddedAt      DateTime?
  // Why this row was held for review, when it was: "cluster" (the topic already
  // has two or more near-identical entries) or "unfounded" (written by a run that
  // never attempted the action it makes claims about). Null when nothing tripped.
  flagReason      String?
  // When a human should look at this again. Set from the type on approval, since
  // a CORRECTION tied to a since-fixed failure goes stale far faster than a
  // PATTERN describing durable policy. Past due surfaces for review; it never
  // auto-deletes, because silently dropping a buyer's knowledge is worse than a
  // stale entry somebody can see.
  reviewDueAt     DateTime?
  // usageCount counts injections and always has — the poller marks knowledge used
  // when it forwards it, before any outcome exists. These two give that number a
  // meaning: how often this lesson was put in front of the agent, and how often
  // the agent then did nothing. A lesson that keeps preceding inaction is
  // suppressing work rather than helping, which is the signature of the seven
  // "do not attempt" lessons that made the agent refuse to email its own manager.
  injectedCount   Int                @default(0)
  noActionCount   Int                @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime           @default(now())
  agent           Agent              @relation(fields: [agentId], references: [id])
  deployment      Deployment         @relation(fields: [deploymentId], references: [id])
  votes           KnowledgeVote[]
  comments        ContributionComment[]
  mutes           ContributionMute[]

  @@index([agentId, status])
  @@index([status])
}

/// One deployment's decision to stop using one commons lesson.
///
/// AgentMind is shared across every deployment of an agent — search filters on
/// agentId, not deploymentId — so a lesson written by one buyer reaches all of
/// them. Deleting is company-scoped and rightly returns 403 to anyone else, which
/// left a buyer harmed by another buyer's lesson with no remedy at all short of
/// disabling AgentMind entirely. This is that remedy, scoped to the one
/// deployment so it cannot affect anybody else's agent.
model ContributionMute {
  id             String                @id @default(cuid())
  contributionId String
  deploymentId   String
  reason         String?
  createdAt      DateTime              @default(now())
  contribution   KnowledgeContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  deployment     Deployment            @relation(fields: [deploymentId], references: [id])

  @@unique([contributionId, deploymentId])
  @@index([deploymentId])
}

model ContributionComment {
  id             String                @id @default(cuid())
  contributionId String
  deploymentId   String
  agentName      String
  content        String
  createdAt      DateTime              @default(now())
  contribution   KnowledgeContribution @relation(fields: [contributionId], references: [id])
  deployment     Deployment            @relation(fields: [deploymentId], references: [id])

  @@index([contributionId])
}

model Payout {
  id                String       @id @default(cuid())
  creatorId         String
  periodStart       DateTime
  periodEnd         DateTime
  grossRevenueCents Int
  platformFeeCents  Int
  creatorShareCents Int
  status            PayoutStatus @default(PENDING)
  stripeTransferId  String?
  failureReason     String?
  createdAt         DateTime     @default(now())
  paidAt            DateTime?
  creator           Creator      @relation(fields: [creatorId], references: [id])

  @@index([creatorId, periodStart])
  @@index([status])
}

model KnowledgeVote {
  id             String                @id @default(cuid())
  contributionId String
  deploymentId   String
  vote           Int
  createdAt      DateTime              @default(now())
  contribution   KnowledgeContribution @relation(fields: [contributionId], references: [id])
  deployment     Deployment            @relation(fields: [deploymentId], references: [id])

  @@unique([contributionId, deploymentId])
}

enum AgentCategory {
  SALES_OPERATIONS
  CUSTOMER_SUCCESS
  EXECUTIVE_ASSISTANT
  RESEARCH
  MARKETING_OPS
  HR_OPS
  FINANCE_OPS
  ENGINEERING_OPS
  GENERAL
  IT_SUPPORT
}

enum AgentRuntime {
  CUSTOM
}

enum AgentStatus {
  DRAFT
  IN_REVIEW
  LIVE
  SUSPENDED
}

enum VetStatus {
  PENDING
  PASSED
  FAILED
  MANUALLY_APPROVED
}

enum DeploymentStatus {
  PENDING_PAYMENT
  PROVISIONING
  ONBOARDING
  ACTIVE
  PAUSED
  FIRED
  ERROR
}

enum OnboardingState {
  INTERVIEW
  OBSERVATION
  INTRODUCTION
  LIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EDITED
  REJECTED
  EXPIRED
}

enum ModelTier {
  STANDARD
  PRO
  PREMIUM
}

enum CompanyPlan {
  PAY_PER_AGENT
  TEAM
  ENTERPRISE
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContributionType {
  CORRECTION
  PATTERN
  RESPONSE_TEMPLATE
  TASK_RECIPE
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum WorkspaceProvider {
  GOOGLE
  MICROSOFT
  NONE
}

enum CreatorStatus {
  PENDING
  APPROVED
  DENIED
}
